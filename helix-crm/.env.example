# Supabase — Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# הכתובת הציבורית של האתר (ל-OAuth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Resend — התראות מייל ליזמים + דייג'סט שבועי (אופציונלי)
RESEND_API_KEY=
RESEND_FROM=HELIX STAGE <onboarding@resend.dev>

# Service role — פעולות שרת שעוקפות RLS. אף פעם לא NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# סוד לנתיבי הקרון. נשלח ככותרת Authorization: Bearer <value> בלבד —
# ?secret= בשורת הכתובת כבר לא נתמך (נוחת בלוגים).
# /api/digest משתמש ב-DIGEST_SECRET; /api/email/run-scheduled ב-SCHEDULED_EMAIL_SECRET
# (ונופל חזרה ל-DIGEST_SECRET אם לא הוגדר).
DIGEST_SECRET=
SCHEDULED_EMAIL_SECRET=

# חתימת יעד ההפניה בקישורי מעקב ההקלקות במיילים. אם לא מוגדר — נגזר
# מ-DIGEST_SECRET. בלעדיו /api/email/click מפנה רק לאתר עצמו.
EMAIL_LINK_SECRET=

# CHIEF AI
ANTHROPIC_API_KEY=

# COOKIE_DOMAIN — אין. עוגיית הסשן נשארת host-only במכוון; ה-scope מוגדר
# במקום אחד, lib/supabase/cookie-options.ts. ראה את ההסבר ב-apphosting.yaml.

# ── Cal.com scheduling (open-source Calendly) — real slots + bookings for CHIEF ──
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
