{
  "hosting": {
    "public": "out",
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": ["**/.*", "**/node_modules/**"],
    "redirects": [
      { "source": "/services/tools", "destination": "/products", "type": 301 },
      { "source": "/services/sales", "destination": "/products/sdr", "type": 301 }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(jpg|jpeg|png|gif|webp|svg|ico|woff|woff2|mp4|lottie)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=2592000" }
        ]
      }
    ]
  },
  "apphosting": {
    "backendId": "helix-website",
    "rootDir": ".",
    "ignore": [
      "node_modules",
      ".git",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".next",
      "PRODUCTS",
      "frames",
      "lottie-work",
      "stitch-analysis",
      "reference",
      ".env",
      ".env.local",
      ".env.*.local",
      ".claude"
    ]
  }
}
