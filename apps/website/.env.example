# Google Analytics 4 — Measurement ID from analytics.google.com
# (Admin → Data Streams → your web stream → "Measurement ID", format: G-XXXXXXXXXX)
# Leave unset locally so dev traffic is not tracked. Set it in Vercel for production.
NEXT_PUBLIC_GA_ID=G-NT22TNKPT4

# Meta (Facebook) Pixel — Pixel ID from Meta Events Manager
# (business.facebook.com/events_manager → Data Sources → your pixel → numeric ID)
# Set it in Vercel for production. Leave unset locally to avoid tracking dev traffic.
NEXT_PUBLIC_FB_PIXEL_ID=

# ---------------------------------------------------------------------------
# TRACKING / PIXELS — all OPTIONAL and all gated on cookie consent (nothing
# loads until the visitor accepts the cookie banner). Two ways to run:
#   • GTM route:   set NEXT_PUBLIC_GTM_ID and manage every tag inside GTM.
#   • Direct route: set the individual IDs below (GA above + the ones here).
# Use one route OR the other so events aren't counted twice.

# Google Tag Manager container — GTM-XXXXXXX (tagmanager.google.com).
NEXT_PUBLIC_GTM_ID=

# Google Ads conversion tag — AW-XXXXXXXXXX (Google Ads → Tools → Conversions).
# The per-conversion "label" is passed in code via trackLead({ adsLabel }).
NEXT_PUBLIC_GOOGLE_ADS_ID=

# LinkedIn Insight Tag — numeric Partner ID
# (Campaign Manager → Analytics → Insight Tag → "I will use a tag manager"/manual).
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# TikTok Pixel — Pixel ID from TikTok Ads Manager → Assets → Events → Web.
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Microsoft Clarity — free heatmaps + session recordings. Project ID from
# clarity.microsoft.com → Settings → Overview.
NEXT_PUBLIC_CLARITY_ID=

# ---------------------------------------------------------------------------
# Search-engine ownership verification (server-rendered <meta> tags).
# Google Search Console → add property → "HTML tag" → copy the content= token.
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools → Verify → "Meta tag" → copy the content= token.
BING_SITE_VERIFICATION=

# Resend — server-side API key for the /vibe-code workshop registration form
# Create one at resend.com → API Keys. Server-only — must NOT be prefixed NEXT_PUBLIC_.
# Real value goes in .env.local (gitignored), and in Vercel project settings.
RESEND_API_KEY=

# Inbox that receives workshop registration notifications.
# Default to Eran's working address until eran@helix.co.il is live via Google Workspace.
RESEND_NOTIFY_TO=eranlips@gmail.com

# ---------------------------------------------------------------------------
# /ai-checker — live AI-visibility layer (Layer A).
# ALL of these are OPTIONAL. With none set, the checker still runs the free
# Layer B checks (crawlability, structure, Common Crawl, Wikidata). Each key you
# add turns on that model's "does AI know/recommend you" probe. Connect these
# when the site moves to the main domain. Server-only — never NEXT_PUBLIC_.
#
# Perplexity Sonar (search-native, citations) — also powers the free teaser hook.
#   Get it at: perplexity.ai/settings/api
PERPLEXITY_API_KEY=
# Anthropic Claude (web_search tool). Get it at: console.anthropic.com
ANTHROPIC_API_KEY=
# OpenAI / ChatGPT (Responses API + web_search). Get it at: platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini (google_search grounding). Get it at: aistudio.google.com/apikey
GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# /ai-checker — store every scanned site + lead in Supabase (optional).
# With these unset, scans still work; they just are not persisted.
# 1) Run docs/geo_scans.sql once in the Supabase SQL editor.
# 2) SUPABASE_URL — Project URL (Settings → API → Project URL).
# 3) SUPABASE_SERVICE_KEY — the service_role key (Settings → API). Server-only —
#    never expose it to the client / never prefix NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ---------------------------------------------------------------------------
# /free-tools/ai-context — browser-side lead capture (lib/context-lead.ts).
# The static export has no server, so the questionnaire INSERTs to Supabase
# straight from the browser with the PUBLIC anon key, protected by an
# anon-INSERT-only RLS policy. Run docs/context_kit_leads.sql AND
# docs/rls_lockdown.sql FIRST — do not set these until anon has INSERT on
# context_kit_leads and nothing else, or the key becomes a read credential for
# every lead table. Both are inlined into the client bundle at BUILD time, so
# they must be set in the CI build environment, not only at runtime.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Scan quality (all OPTIONAL, all server-only).
# Firecrawl — JS-rendered fetch, so SPA sites are scanned as a browser sees
# them instead of as an empty shell. Unset = raw fetch only.
FIRECRAWL_API_KEY=
# Self-hosted Firecrawl instance. Leave unset for the hosted api.firecrawl.dev.
FIRECRAWL_BASE_URL=
# PageSpeed Insights — raises the per-IP quota. Keyless PSI is throttled per
# SOURCE IP; on Cloud Run the egress IP is shared, so under real traffic PSI
# returns non-200 and both consumers degrade to a 'partial' result.
PAGESPEED_API_KEY=

# Trailing x-forwarded-for entries to skip when deriving the client IP
# (lib/client-ip.ts). 1 = Cloud Run direct, 2 = behind an external LB.
# Verify against a real deploy by logging the full header once.
XFF_TRUSTED_HOPS=1

# Optional endpoint for the "deep analysis" button on /free-tools/ai-context.
# Browser-exposed — must be rate-limited and authenticated if you ever set it.
# Unset = the WhatsApp fallback, which is the intended default.
NEXT_PUBLIC_AI_RECO_ENDPOINT=
